# Supabase Connection Credentials (PLACEHOLDERS ONLY - DO NOT COMMIT REAL KEYS)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Private Storage Buckets
SUPABASE_MRI_BUCKET=mri-scans
SUPABASE_REPORT_BUCKET=patient-reports
SIGNED_URL_TTL_SECONDS=300

# File Upload Limits (MB)
MAX_MRI_UPLOAD_MB=15
MAX_REPORT_UPLOAD_MB=20

# AI & Reliability Decision Thresholds
AI_CONFIDENCE_THRESHOLD=0.70
AI_UNCERTAINTY_THRESHOLD=0.025

# Legacy Database Fallback (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///tumorai.db
SECRET_KEY=tumorai_super_secret_key_2026

# Gmail SMTP Configuration for Password Reset OTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password

